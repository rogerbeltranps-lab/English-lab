rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function school() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email.matches('.*@(ietramuntana[.]cat)$'); }  // add schools: (ietramuntana[.]cat|newschool[.]cat) and in shared/js/el-firebase.js DOMAINS
    function myEmail() { return request.auth.token.email.lower(); }
    // testers: school accounts that work as students but reach every LS (also in shared/js/el-firebase.js TESTERS)
    function isTester() { return school() && myEmail() in ['roger.beltran@ietramuntana.cat']; }
    // students: only school accounts on the teacher's student list (roster/{email}), plus testers
    function roster() { return /databases/$(database)/documents/roster/$(myEmail()); }
    function signedIn() { return school() && (isTester() || exists(roster())); }
    function rosterGroup() { return get(roster()).data.group; }
    function inGroup(group) { return signedIn() && (isTester() || rosterGroup() == group); }   // a student of that class group, or a tester
    function isTeacher() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email in ['roger.beltranps@gmail.com']; }
    // LS assigned to the student's group (the group of the student list): ls/{id}.groups, or every group when the field is missing
    function lsForMe(ls, uid) { return !('groups' in get(/databases/$(database)/documents/ls/$(ls)).data) || rosterGroup() in get(/databases/$(database)/documents/ls/$(ls)).data.groups; }
    function lsOpen(ls) { return exists(/databases/$(database)/documents/ls/$(ls)) && get(/databases/$(database)/documents/ls/$(ls)).data.status in ['open', 'public']; }   // 'public' was removed from the dashboard (26 Oct 2026); a stored one counts as open
    // learning paths the teacher has locked for the student's group (dashboard; elLpLocks in shared/js/el-catalog.js): ls/{id}.locked[group] = activity ids,
    // ls/{id}.lockedKeys[group] = the progress keys they save. A group without the lists has nothing locked here.
    function lockedFor(ls, field) { return get(/databases/$(database)/documents/ls/$(ls)).data.get(field, {}).get(rosterGroup(), []); }
    function progressChanged() { return request.resource.data.get('data', {}).diff(resource == null ? {} : resource.data.get('data', {})).affectedKeys(); }

    // LS release state: hidden | open | closed (written by the teacher only)
    match /ls/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }
    // The teacher's own checklist of the time plan (ticked sessions per group): only the teacher
    match /teacherPlan/{group} {
      allow read, write: if isTeacher();
    }
    // The teacher's dashboard settings (routes: the LS1 exam cut-offs per course): only the teacher
    match /settings/{id} {
      allow read, write: if isTeacher();
    }
    match /assignments/{day} {
      allow read: if signedIn() || isTeacher();
      allow write: if isTeacher();
    }
    // problem reports (the "Problem" button in the bottom bar): signed-in students and testers send them with where they happened; only the teacher reads, marks or deletes them
    function shortText(v, n) { return v == null || (v is string && v.size() <= n); }
    match /problems/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','email','name','group','ls','activity','route','page','title','section','kind','text','errors','device','shot','created'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == myEmail()
        && request.resource.data.kind in ['media','stuck','marking','display','other']
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && shortText(request.resource.data.get('name', null), 200) && shortText(request.resource.data.get('page', null), 300)
        && shortText(request.resource.data.get('title', null), 200) && shortText(request.resource.data.get('section', null), 200)
        && shortText(request.resource.data.get('ls', null), 80) && shortText(request.resource.data.get('activity', null), 120)
        && shortText(request.resource.data.get('device', null), 100)
        && request.resource.data.get('route', null) in [null, 'beginners', 'insecure', 'safe', 'daring', 'native']
        && request.resource.data.get('group', null) in [null, '2ESOA', '2ESOB', '4ESOA', '4ESOB']
        && request.resource.data.get('errors', []) is list && request.resource.data.get('errors', []).size() <= 5
        && request.resource.data.get('shot', null) in [null, 'page', 'file']
        && request.resource.data.created == request.time;
      allow read, update, delete: if isTeacher();
    }
    // the screenshot of a problem report (same id), written in the same batch as the report: a JPEG data URL, read only by the teacher
    // the teacher's answer to a problem report (same id): "fixed" when marked as fixed, "thanks" when deleted; the student reads it once and deletes it
    match /problemReplies/{id} {
      allow read, delete: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if isTeacher();
    }
    match /problemShots/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','img','created'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.img is string && request.resource.data.img.size() <= 900000
        && request.resource.data.created == request.time
        && getAfter(/databases/$(database)/documents/problems/$(id)).data.uid == request.auth.uid;
      allow read, delete: if isTeacher();
    }
    // student list: doc id = school email in lower case; {group, surname1, surname2, first, tutor, email}. Written only by the teacher (dashboard import).
    match /roster/{email} {
      allow read: if isTeacher() || (school() && email == myEmail());
      allow write: if isTeacher();
    }
    // team points (shared/js/el-points.js): points/{email in lower case} = {team, t1, t2, t3}, written by the teacher (class presentations
    // and dashboard); each student reads their own. teams/{group} = {list, score, best}: team names and scores, no personal data,
    // so the group's students read it.
    match /points/{email} {
      allow read: if isTeacher() || (school() && email == myEmail());
      allow write: if isTeacher();
    }
    match /teams/{group} {
      allow read: if isTeacher() || inGroup(group);
      allow write: if isTeacher();
    }
    // live class (shared/js/el-deck-points.js): live/{group} = where the teacher's presentation is (slide, step); buzz/{group} = {open, q, out, winner}.
    // Only the teacher writes them; a student of the group reads them and can buzz once: set the winner while the buzzers are open and nobody
    // has won, for their own team (points/{email}.team), not for a team that is out of this question, at the server's time.
    match /live/{group} {
      allow read: if isTeacher() || inGroup(group);
      allow write: if isTeacher();
    }
    // class quiz: live/{group}/answers/{email} = {sid, a:{question: value}, at}. Each student of the group writes their own answers
    // while following the presentation and reads them back (to keep them when they come back to the same class); only the teacher
    // reads everyone's (the projector shows the counts). Testers answer too (Roger, 26 Oct 2026: to see the game and the bonus work
    // with his school account); their points never count for the group's best (lab/game/host.js, el-deck-points.js use the student list).
    match /live/{group}/answers/{email} {
      allow read, write: if isTeacher();
      allow get: if school() && email == myEmail();
      allow create, update: if inGroup(group) && email == myEmail()
        && request.resource.data.keys().hasOnly(['sid', 'a', 'at'])
        && request.resource.data.sid is number && request.resource.data.a is map && request.resource.data.a.size() <= 300;
    }
    match /buzz/{group} {
      allow read: if isTeacher() || inGroup(group);
      allow write: if isTeacher();
      allow update: if signedIn() && !isTester() && rosterGroup() == group
        && resource.data.open == true && resource.data.get('winner', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['winner'])
        && request.resource.data.winner.keys().hasOnly(['team', 'at'])
        && request.resource.data.winner.at == request.time
        && request.resource.data.winner.team == get(/databases/$(database)/documents/points/$(myEmail())).data.team
        && !(request.resource.data.winner.team in resource.data.get('out', []));
    }
    match /students/{uid} {
      // class group: listed students copy the group of the student list; testers set it once (first sign-in); after that only the teacher changes it
      allow read: if (signedIn() && request.auth.uid == uid) || isTeacher();
      allow create: if signedIn() && request.auth.uid == uid
        && (isTester()
              ? request.resource.data.get('group', '2ESOA') in ['2ESOA','2ESOB','4ESOA','4ESOB']
              : request.resource.data.get('group', null) in [null, rosterGroup()]);
      allow update: if signedIn() && request.auth.uid == uid
        && (request.resource.data.get('group', null) == resource.data.get('group', null)
            || (isTester()
                  ? resource.data.get('group', null) == null && request.resource.data.get('group', '2ESOA') in ['2ESOA','2ESOB','4ESOA','4ESOB']
                  : request.resource.data.get('group', null) == rosterGroup()));
      allow write: if isTeacher();

      // progress is writable only while that LS is open, and never in a learning path locked for the student's group
      match /progress/{ls} {
        allow read: if (signedIn() && request.auth.uid == uid) || isTeacher();
        allow create, update: if signedIn() && request.auth.uid == uid
          && ((lsOpen(ls) && lsForMe(ls, uid) && !progressChanged().hasAny(lockedFor(ls, 'lockedKeys'))) || isTester());
      }
      // route (level): the teacher sets it (Roger, 26 Oct 2026: from the LS1 exam mark). 2 ESO (Roger, 26 Oct 2026): a student with no
      // route chooses one (Base, Core, Plus) and can change it, as by:"student"; a doc the teacher wrote (no by) is locked for the student.
      match /levels/{ls} {
        allow read: if (signedIn() && request.auth.uid == uid) || isTeacher();
        allow create, update: if signedIn() && request.auth.uid == uid && ls.matches('2eso-.*')
          && (isTester() || rosterGroup() in ['2ESOA', '2ESOB'])
          && (resource == null || resource.data.get('by', null) == 'student')
          && request.resource.data.keys().hasOnly(['level','by','updated'])
          && request.resource.data.by == 'student'
          && request.resource.data.level in ['insecure','safe','daring'];
        allow write: if isTeacher();
      }
      // results: students cannot touch feedback, nor edit a locked (submitted) result
      match /results/{rid} {
        allow read: if (signedIn() && request.auth.uid == uid) || isTeacher();
        allow create, update: if signedIn() && request.auth.uid == uid
          && ((lsOpen(request.resource.data.ls) && lsForMe(request.resource.data.ls, uid)
                && !(request.resource.data.activity in lockedFor(request.resource.data.ls, 'locked'))) || isTester())
          && (resource == null || resource.data.get('locked', false) == false)
          && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(['ls','activity','done','locked','markedDone','updated','parts','score','max']);
        allow write: if isTeacher();
      }
    }
    match /{path=**}/results/{rid} {
      allow read: if isTeacher();
    }
    match /{path=**}/levels/{ls} {
      allow read: if isTeacher();
    }
    match /{path=**}/progress/{ls} {
      allow read: if isTeacher();
    }
  }
}
